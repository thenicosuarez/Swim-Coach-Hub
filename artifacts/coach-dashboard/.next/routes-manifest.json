{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/coach/bookings/[id]/approve",
      "regex": "^/api/coach/bookings/([^/]+?)/approve(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/coach/bookings/(?<nxtPid>[^/]+?)/approve(?:/)?$"
    },
    {
      "page": "/api/coach/bookings/[id]/reject",
      "regex": "^/api/coach/bookings/([^/]+?)/reject(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/coach/bookings/(?<nxtPid>[^/]+?)/reject(?:/)?$"
    },
    {
      "page": "/api/coach/clients/[id]",
